# Control plane (always Postgres; holds tenants, queries, embeddings, DLQ)
DATABASE_URL=postgres://queryline:queryline@localhost:5432/queryline
REDIS_URL=redis://localhost:6379

# Warehouse under analysis: postgres | mssql | oracle
WAREHOUSE_KIND=postgres
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=queryline_reader
WAREHOUSE_PASSWORD=queryline_reader
WAREHOUSE_DATABASE=queryline
WAREHOUSE_SCHEMA=warehouse
# Oracle only
WAREHOUSE_SERVICE_NAME=FREEPDB1
# MSSQL only
WAREHOUSE_ENCRYPT=false
WAREHOUSE_TRUST_SERVER_CERTIFICATE=true

# Per-tenant isolation. Tables flagged tenant_scoped must be filtered by the model.
TENANT_ID=demo-tenant

# Model provider: openai | mock
MODEL_PROVIDER=mock
MODEL_NAME=gpt-4o-mini
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# USD per 1M tokens, used for eval cost accounting
MODEL_INPUT_PRICE=0.15
MODEL_OUTPUT_PRICE=0.60

# Guardrails
MAX_ROWS=1000
MAX_ESTIMATED_ROWS=5000000
MAX_ESTIMATED_COST=250000
MAX_SQL_LENGTH=20000
QUERY_TIMEOUT_MS=8000
EXPLAIN_TIMEOUT_MS=2000
MAX_REPAIRS=2

# Backpressure
QUEUE_DEPTH_LIMIT=200
TENANT_CONCURRENCY=3
GLOBAL_CONCURRENCY=12

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=queryline-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Cassette mode for deterministic CI evals
EVAL_CASSETTE_DIR=evals/cassettes

PORT=3000
LOG_LEVEL=info
